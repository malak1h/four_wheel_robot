<?xml version="1.0"?>
<sdf version="1.6">
  <world name="room">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.2 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.2 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstacles -->
    <model name="box_1">
      <static>true</static>
      <pose>2 1.5 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-1.5 -2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.4 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>-2 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
